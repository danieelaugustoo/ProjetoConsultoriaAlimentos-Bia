# =========================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env (ele está no .gitignore).
# =========================================================================

# Ambiente: development | production
APP_ENV=production

# Chave secreta do Flask (sessões, CSRF). Gere uma nova:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookies só por HTTPS (mantenha True em produção)
SESSION_COOKIE_SECURE=True

# URL pública do site (usada para montar links nos e-mails)
SITE_URL=https://bvconsultora.com

# --- Banco de dados ------------------------------------------------------
# Padrão: SQLite em instance/app.db. Para outro banco, informe a URL SQLAlchemy.
# DATABASE_URL=sqlite:////caminho/absoluto/app.db

# --- Envio de e-mail (Brevo) ------------------------------------------
# Provedor: brevo_api (recomendado) | brevo_smtp (fallback) | console (dev, não envia)
EMAIL_PROVIDER=brevo_api

# brevo_api:
BREVO_API_KEY=

# brevo_smtp (fallback caso a hospedagem bloqueie saída HTTPS para api.brevo.com):
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Remetente. Ideal: e-mail no domínio bvconsultora.com autenticado (SPF/DKIM) na Brevo.
# Se não for possível editar o DNS, use o Gmail validado como remetente na Brevo.
MAIL_FROM=contato@bvconsultora.com
MAIL_FROM_NAME=Beatriz Vasconcelos - Consultora de Alimentos
MAIL_REPLY_TO=beatriz.consultoradealimentos@gmail.com

# --- Contatos exibidos no site e no rodapé dos e-mails ----------------
CONTATO_EMAIL=beatriz.consultoradealimentos@gmail.com
CONTATO_WHATSAPP=https://api.whatsapp.com/send?phone=5511945097739
CONTATO_INSTAGRAM=https://www.instagram.com/beatriz.consultoradealimentos/
CONTATO_LINKEDIN=https://www.linkedin.com/in/beatrizvasconcelosconsultora/

# --- Cloudflare Turnstile (anti-bot no formulário) --------------------
# Deixe False até ter as chaves. Crie um widget em https://dash.cloudflare.com/ > Turnstile
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Limites (opcionais; valores padrão já são razoáveis) ------------
# RATELIMIT_PUBLICO=5 per hour
# RATELIMIT_LOGIN=5 per minute
# DOWNLOAD_TOKEN_TTL_DIAS=7
# DOWNLOAD_TOKEN_MAX_USOS=5
